# Copy thành .env để chạy thử trên máy (KHÔNG commit .env). Trên Render nhập các biến này ở mục Environment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/diemdanh
JWT_SECRET=<chuoi-ngau-nhien-dai>
# Web client ID trong Google Cloud Console (dùng làm serverClientId trong app Flutter)
GOOGLE_CLIENT_ID=<xxxx>.apps.googleusercontent.com
BREVO_API_KEY=<api-key-brevo>
# Email người gửi đã xác minh trong Brevo
MAIL_FROM=<email-cua-ban>@gmail.com

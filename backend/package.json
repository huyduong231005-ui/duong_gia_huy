{
  "name": "duong-gia-huy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API chung cho app điểm danh sinh viên (nhóm 4 con tuất)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
